{
  "name": "drawboard-minimal",
  "productName": "Drawboard Minimal",
  "version": "1.0.1",
  "description": "Draw and solve equations over any window.",
  "main": "main.js",
  "author": "Jorge Lemos <jorgylemos@outlook.com>",
  "desktopName": "com.drawboard.minimal.desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "publish": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.drawboard.minimal",
    "productName": "Drawboard Minimal",
    "publish": [
      {
        "provider": "github",
        "owner": "jorgylemos",
        "repo": "drawboard"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "maintainer": "Jorge Lemos <jorgylemos@outlook.com>",
      "synopsis": "Draw and solve equations over any window",
      "description": "Drawboard Minimal - Draw and solve equations over any window."
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libnss3",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
